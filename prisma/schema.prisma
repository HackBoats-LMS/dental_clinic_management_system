// For the Call TRanscript and Summary--------------------------------//
model CallList {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String
  status      String   @default("PENDING") // PENDING, CONTACTED, NOT_LIFTED, OTHER
  notes       String?
  callDate    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Recordings {
  recordId    String  @id @default(uuid())
  id          String  @unique
  fileName    String
  mimeType    String
  driveLink   String
  Time        String?
  date        String
  source      String?
  phoneNumber String
  Transcript  String?
  callType    String?
  purpose     String?
  details     String?
  outcome     String?
  followUp    String?

  // Summary     String?
  
}

