generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Existing tables (already in Supabase) ────────────────────────────────────

model Admin {
  name    String
  email   String @unique
  phone   String?
  adminId String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

model Receptionist {
  name           String
  email          String @unique
  phone          String
  requests               request[]
  receptionistId String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

model CallList {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  callDate    DateTime @default(now())
}

model Recordings {
  recordId    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id          String   @unique
  fileName    String
  mimeType    String
  driveLink   String
  date        String
  phoneNumber String
  Transcript  String?
  Time        String?
  source      String?
  callType    String?
  details     String?
  followUp    String?
  outcome     String?
  purpose     String?
  duration    Decimal? @db.Decimal
}

// ─── New tables (to be created in Supabase) ───────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

model patient {
  patientId              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileComplete        Boolean @default(false)
  name                   String
  age                    Int?
  gender                 String?
  phoneNumber            String? @unique
  email                  String? @unique
  emergencyContact       String?
  previousDentalHistory  String?
  medicalConditions      String?
  requests               request[]
  familyMembers          familyMembers[]

  op     op[]
  visits visit[]
}

model familyMembers {
  fId     String @default(dbgenerated("gen_random_uuid()")) @db.Uuid @id 
  name    String
  age     Int?
  gender  String?
  phoneNumber            String?
  email                  String?
  previousDentalHistory  String?
  medicalConditions      String?

  op     op[]
  visits visit[]
  relation String? 
  patientId String  @db.Uuid
  requests               request[]
  patient   patient @relation(fields: [patientId], references: [patientId])
}

model doctor {
  doctorId  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  age       Int?
  phoneNo   String
  email     String @unique
  isPresent Boolean @default(false)
  isQueuePaused Boolean @default(false)
  currentToken Int @default(0)

  op     op[]
  visits visit[]
  schedules doctorSchedule[]
}

model op {
  opId      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime
  

  patientId String  @db.Uuid
  requests               request[]
  familyMemberId String? @db.Uuid
  familyMember   familyMembers? @relation(fields: [familyMemberId], references: [fId])

  patient   patient @relation(fields: [patientId], references: [patientId])
  doctorId  String  @db.Uuid
  doctor    doctor  @relation(fields: [doctorId], references: [doctorId])

  visits visit[]

  @@index([patientId, expiresAt])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model request {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime      @default(now())

  status         RequestStatus @default(PENDING)

  patientId      String        @db.Uuid
  patient        patient       @relation(fields: [patientId], references: [patientId])

  familyMemberId String?       @db.Uuid
  familyMember   familyMembers? @relation(fields: [familyMemberId], references: [fId])

  opId           String        @db.Uuid
  op             op            @relation(fields: [opId], references: [opId])

  approvedById   String?       @db.Uuid
  approvedBy     Receptionist? @relation(fields: [approvedById], references: [receptionistId])
  approvedAt     DateTime?

  @@index([status])
  @@index([patientId])
  @@index([status, createdAt])
}

model appointment {
  appointmentId String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isVerified    Boolean @default(false)
}

model visit {
  visitId   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitDate DateTime
  isVerified Boolean @default(false)

  tokenNumber Int
  doctorId    String  @db.Uuid
  patientId   String  @db.Uuid
  familyMemberId String? @db.Uuid
  opId        String? @db.Uuid

  op      op?     @relation(fields: [opId], references: [opId])
  doctor  doctor  @relation(fields: [doctorId], references: [doctorId])
  patient patient @relation(fields: [patientId], references: [patientId])
  familyMember   familyMembers? @relation(fields: [familyMemberId], references: [fId])

  problems   String[] @default([])
  procedures String[] @default([])

  consultationStatus String @default("WAITING") // WAITING, IN_CONSULTATION, COMPLETED

  treatmentPlan treatmentPlan?

  @@index([visitDate])
  @@index([isVerified])
  @@index([doctorId])
  @@index([visitDate, doctorId])
}

model PredefinedProblem {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
}

model PredefinedProcedure {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
}

// ─── Treatment Planning ──────────────────────────────────────────────────────

model treatmentPlan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId           String   @unique @db.Uuid
  visit             visit    @relation(fields: [visitId], references: [visitId])

  selectedProcedure String
  totalSessions     Int
  status            String   @default("PENDING") // PENDING, ACTIVE, COMPLETED

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions          treatmentSession[]

  @@index([status])
}

model treatmentSession {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treatmentPlanId String       @db.Uuid
  treatmentPlan   treatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  sessionNumber   Int
  scheduledDate   DateTime

  status          String       @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([scheduledDate, status])
}

model doctorSchedule {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId     String  @db.Uuid
  doctor       doctor  @relation(fields: [doctorId], references: [doctorId], onDelete: Cascade)

  dayOfWeek    Int     // 0=Sunday .. 6=Saturday
  startTime    String  // "09:00"
  endTime      String  // "17:00"

  isAvailable  Boolean @default(true)

  createdAt    DateTime @default(now())

  @@unique([doctorId, dayOfWeek])
}

// ─── Materialized Views ───────────────────────────────────────────────────────

model receptionist_queue_mv {
  visitId       String   @id @db.Uuid
  tokenNumber   Int
  visitDate     DateTime
  doctorId      String   @db.Uuid
  doctorName    String
  isPresent     Boolean
  currentToken  Int
  patientName   String
  phoneNumber   String?
  
  @@map("receptionist_queue_mv")
}
